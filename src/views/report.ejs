<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= payload?.title || "Intelligence Report" %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #f5f5f5;
      line-height: 1.6;
    }
    .container {
      max-width: 1000px;
      margin: 0 auto;
      background: white;
      padding: 40px;
    }
    .header {
      border-bottom: 3px solid #2563eb;
      padding-bottom: 20px;
      margin-bottom: 30px;
    }
    .header h1 {
      color: #1e40af;
      font-size: 26px;
      margin-bottom: 4px;
    }
    .header p {
      color: #666;
      font-size: 12px;
    }
    .section-title {
      background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%);
      color: white;
      padding: 12px 16px;
      margin: 30px 0 15px 0;
      border-radius: 4px;
      font-size: 14px;
      font-weight: 600;
    }
    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 20px;
    }
    .info-box {
      background: #f0f4ff;
      border-left: 3px solid #2563eb;
      padding: 10px;
      border-radius: 3px;
    }
    .info-label {
      font-size: 11px;
      color: #666;
      font-weight: 600;
      margin-bottom: 2px;
    }
    .info-value {
      font-size: 13px;
      color: #1e40af;
      font-weight: 500;
      word-break: break-word;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-bottom: 20px;
    }
    .stat-box {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 4px;
      padding: 12px;
      text-align: center;
    }
    .stat-number {
      font-size: 20px;
      font-weight: bold;
      color: #1e40af;
    }
    .stat-label {
      font-size: 11px;
      color: #666;
      margin-top: 4px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 15px;
      font-size: 11px;
    }
    table thead {
      background: #1e40af;
      color: white;
    }
    table th {
      padding: 8px;
      text-align: left;
      font-weight: 600;
    }
    table td {
      padding: 6px 8px;
      border-bottom: 1px solid #e5e7eb;
    }
    table tbody tr:nth-child(odd) {
      background: #f9fafb;
    }
    .summary-box {
      background: #f0f4ff;
      border-left: 3px solid #2563eb;
      padding: 10px;
      margin-bottom: 10px;
      border-radius: 3px;
      font-size: 12px;
      line-height: 1.4;
    }
    .summary-title {
      font-weight: 600;
      color: #1e40af;
      margin-bottom: 4px;
    }
    .entity-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .entity-badge {
      background: #e0e7ff;
      color: #1e40af;
      padding: 6px;
      border-radius: 3px;
      font-size: 11px;
      border-left: 2px solid #2563eb;
    }
    .page-break { page-break-after: always; margin-bottom: 30px; }
    .footer {
      margin-top: 40px;
      border-top: 1px solid #e5e7eb;
      padding-top: 10px;
      text-align: center;
      font-size: 10px;
      color: #999;
    }
  </style>
</head>
<body>
  <div class="container">
    <% const st = payload?.stats || {}; %>

    <!-- HEADER -->
    <div class="header">
      <h1><%= payload?.title || "Intelligence Report" %></h1>
      <p>Generated at: <%= new Date(st.generatedAt || Date.now()).toLocaleString("en-IN") %></p>
    </div>

    <!-- TARGET INFO -->
    <div class="section-title">📋 TARGET INFORMATION</div>
    <% const ti = payload?.targetInfo || {}; %>
    <div class="info-grid">
      <div class="info-box"><div class="info-label">TARGET CODE</div><div class="info-value"><%= ti.code || "-" %></div></div>
      <div class="info-box"><div class="info-label">PHONE NUMBER</div><div class="info-value"><%= ti.number || "-" %></div></div>
      <div class="info-box"><div class="info-label">FULL NAME</div><div class="info-value"><%= ti.name || "-" %></div></div>
      <div class="info-box"><div class="info-label">ALIASES</div><div class="info-value"><%= ti.aliases || "-" %></div></div>
      <div class="info-box"><div class="info-label">CATEGORIES</div><div class="info-value"><%= ti.categories || "-" %></div></div>
      <div class="info-box"><div class="info-label">STATUS</div><div class="info-value"><%= ti.status || "-" %></div></div>
    </div>

    <!-- STATS -->
    <div class="section-title">📊 QUICK STATISTICS</div>
    <div class="stats-grid">
      <div class="stat-box"><div class="stat-number"><%= st.totalCalls || 0 %></div><div class="stat-label">Total Calls</div></div>
      <div class="stat-box"><div class="stat-number"><%= st.totalSMS || 0 %></div><div class="stat-label">Total SMS</div></div>
      <div class="stat-box"><div class="stat-number"><%= st.fileCount || 0 %></div><div class="stat-label">Files</div></div>
      <div class="stat-box"><div class="stat-number"><%= st.highPriorityCalls || 0 %></div><div class="stat-label">High Priority</div></div>
    </div>

    <div class="page-break"></div>

    <!-- TOP CALL SUMMARIES -->
    <% const topCalls = payload?.topCallsSummaries || []; %>
    <div class="section-title">🎯 TOP CALL SUMMARIES</div>
    <% if (topCalls.length) { %>
      <% topCalls.forEach(function(call) { %>
        <div class="summary-box">
          <div class="summary-title">Call #<%= call.index %> | <%= call.time %></div>
          <strong>From:</strong> <%= call.from %> →
          <strong>To:</strong> <%= call.to %> |
          <strong>Duration:</strong> <%= call.duration %><br/>
          <strong>Summary:</strong> <%= call.summary %>
        </div>
      <% }) %>
    <% } else { %>
      <p>No top call summaries available</p>
    <% } %>

    <!-- ENTITIES -->
    <% const ent = payload?.entities || {}; %>
    <div class="section-title">🔍 ENTITIES EXTRACTED</div>

    <strong>Persons</strong>
    <div class="entity-list">
      <% (ent.persons || []).slice(0,20).forEach(function(p){ %>
        <div class="entity-badge"><%= p %></div>
      <% }) %>
    </div>

    <strong style="margin-top:10px;display:block;">Locations</strong>
    <div class="entity-list">
      <% (ent.locations || []).slice(0,20).forEach(function(l){ %>
        <div class="entity-badge"><%= l %></div>
      <% }) %>
    </div>

    <strong style="margin-top:10px;display:block;">Organizations</strong>
    <div class="entity-list">
      <% (ent.organizations || []).slice(0,20).forEach(function(o){ %>
        <div class="entity-badge"><%= o %></div>
      <% }) %>
    </div>

    <div class="page-break"></div>

    <!-- KEYWORDS -->
    <% const kw = payload?.keywordsSummary || {}; %>
    <div class="section-title">🔑 KEYWORDS ANALYSIS</div>

    <strong>Target Keywords</strong>
    <% if ((kw.targetKeywords || []).length) { %>
      <table>
        <thead><tr><th>Keyword</th><th>Label</th><th>Call</th><th>SMS</th><th>Total</th></tr></thead>
        <tbody>
          <% kw.targetKeywords.forEach(function(k){ %>
            <tr>
              <td><%= k.keyword %></td>
              <td><%= k.label %></td>
              <td><%= k.callCount %></td>
              <td><%= k.smsCount %></td>
              <td><%= k.totalCount %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p>No target keywords</p>
    <% } %>

    <div class="page-break"></div>

    <!-- CALL RECORDS (DETAIL TABLE, WITH GLOBAL INDEX) -->
    <% const calls = payload?.callRecordsDetailedTable?.rows || []; %>
    <% const globalStartIndex = st.globalStartIndex || 0; %>

    <div class="section-title">
      📞 CALL RECORDS
      <% if (calls.length) { %>
        (Rows <%= globalStartIndex + 1 %> to <%= globalStartIndex + calls.length %>)
      <% } %>
    </div>

    <% if (calls.length) { %>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>DateTime</th>
            <th>Duration</th>
            <th>Caller</th>
            <th>Callee</th>
            <th>Type</th>
            <th>Category</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Language</th>
            <th>Location</th>
            <th>File</th>
          </tr>
        </thead>
        <tbody>
          <% calls.forEach(function(row, idx){ %>
            <tr>
              <td><%= globalStartIndex + idx + 1 %></td>
              <% row.forEach(function(col){ %>
                <td><%= col || "-" %></td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p>No call records found 🫠</p>
    <% } %>

    <div class="footer">
      <p>Confidential Intelligence Report — Unauthorized Distribution Prohibited</p>
    </div>
  </div>
</body>
</html>
